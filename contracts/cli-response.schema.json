{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/britors/OpenBaseNET/main/contracts/cli-response.schema.json",
  "title": "OpenBase CLI response envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "command",
    "ok",
    "data",
    "error",
    "warnings"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/message"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/message"
          }
        }
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "not": { "pattern": "[\\r\\n]" }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
